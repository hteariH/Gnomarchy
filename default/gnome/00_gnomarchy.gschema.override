# Gnomarchy System-wide Default GNOME Configuration
# Installed to /usr/share/glib-2.0/schemas/00_gnomarchy.gschema.override

[org.gnome.shell]
disable-user-extensions=false
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'tactile@lundal.io', 'just-perfection-desktop@just-perfection', 'blur-my-shell@aunetx', 'space-bar@luchrioh', 'tophat@fflewddur.github.io', 'AlphabeticalAppGrid@stuarthayhurst', 'appindicatorsupport@rgcjonas.gmail.com']
# Recomputed from what is actually installed by set-gnome-favorites.sh; this
# default only covers the case where that step has not run yet. Listing
# several browser ids here produced duplicate dash icons.
favorite-apps=['brave-origin.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Nautilus.desktop', 'micro.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Settings.desktop']

[org.gnome.shell.extensions.dash-to-dock]
dock-position='LEFT'
extend-height=true
dock-fixed=true
intellihide=false
dash-max-icon-size=38
show-trash=false
show-mounts=false
multi-monitor=true
show-apps-at-top=false
running-indicator-style='DOTS'
hot-keys=false

[org.gnome.shell.extensions.tactile]
col-0=1
col-1=2
col-2=1
col-3=0
row-0=1
row-1=1
gap-size=18
show-tiles=['<Super>t']

[org.gnome.shell.extensions.just-perfection]
animation=2
dash-app-running=true
workspace=true
workspace-popup=false

[org.gnome.shell.extensions.blur-my-shell.overview]
blur=true
pipeline='pipeline_default'

[org.gnome.shell.extensions.space-bar.behavior]
smart-workspace-names=false

[org.gnome.shell.extensions.space-bar.shortcuts]
enable-activate-workspace-shortcuts=false
enable-move-to-workspace-shortcuts=true

[org.gnome.shell.extensions.tophat]
show-icons=false
show-cpu=true
show-mem=true
show-disk=false
network-usage-unit='bits'

[org.gnome.shell.extensions.alphabetical-app-grid]
folder-order-position='end'

[org.gnome.mutter]
center-new-windows=true
attach-modal-dialogs=true
edge-tiling=true
dynamic-workspaces=false

[org.gnome.desktop.wm.preferences]
num-workspaces=6

[org.gnome.desktop.interface]
monospace-font-name='JetBrainsMono Nerd Font 10'
document-font-name='Noto Sans 10'
font-name='Noto Sans 10'
clock-show-weekday=true
clock-show-date=true
color-scheme='prefer-dark'
accent-color='blue'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/gnomarchy/tokyo-night/tokyo-night.svg'
picture-uri-dark='file:///usr/share/backgrounds/gnomarchy/tokyo-night/tokyo-night.svg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/gnomarchy/tokyo-night/tokyo-night.svg'
picture-uri-dark='file:///usr/share/backgrounds/gnomarchy/tokyo-night/tokyo-night.svg'
picture-options='zoom'

[org.gnome.desktop.calendar]
show-weekdate=true

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true
natural-scroll=true

[org.gnome.settings-daemon.plugins.power]
ambient-enabled=false
sleep-inactive-ac-type='nothing'

[org.gnome.settings-daemon.plugins.color]
night-light-enabled=true
night-light-temperature=4000

# Window management shortcuts as system defaults.
#
# These previously existed only as gsettings writes from the installer, so they
# were lost whenever the installer ran without a session bus. Custom
# keybindings (Super+Return, Super+D, ...) cannot be expressed here because
# they live at relocatable paths; those are applied by gnomarchy-first-run.
[org.gnome.desktop.wm.keybindings]
close=['<Super>w']
maximize=['<Super>Up']
begin-resize=['<Super>BackSpace']
toggle-fullscreen=['<Shift>F11']
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
switch-to-workspace-5=['<Super>5']
switch-to-workspace-6=['<Super>6']
move-to-workspace-1=['<Super><Shift>1']
move-to-workspace-2=['<Super><Shift>2']
move-to-workspace-3=['<Super><Shift>3']
move-to-workspace-4=['<Super><Shift>4']
move-to-workspace-5=['<Super><Shift>5']
move-to-workspace-6=['<Super><Shift>6']
