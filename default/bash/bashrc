# Gnomarchy default bashrc
if [[ $- != *i* ]]; then
  return
fi

# PATH additions
export PATH="$HOME/.local/share/gnomarchy/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# Default editor
#
# VS Code needs --wait, or git sees the editor return immediately and treats
# the commit message as empty. In a TTY or over SSH there is no display for it
# to open on, so fall back to nano, which anyone can drive without knowing it.
# Neovim stays installed and configured for those who want it.
if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v code >/dev/null 2>&1; then
  export EDITOR="code --wait"
  export VISUAL="code --wait"
elif command -v nano >/dev/null 2>&1; then
  export EDITOR="nano"
  export VISUAL="nano"
elif command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
fi

# Enable bash completion
if [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi

# Source aliases
if [ -f "$HOME/.local/share/gnomarchy/default/bash/aliases" ]; then
  source "$HOME/.local/share/gnomarchy/default/bash/aliases"
fi

# Initialize starship prompt if available
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Initialize zoxide (smarter cd) if available
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# Initialize mise (runtime version manager) if available
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi
