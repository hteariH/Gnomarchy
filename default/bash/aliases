# Gnomarchy developer aliases

# Listing (eza) - `ls` is safe to shadow, flags are compatible enough
alias ls='eza --icons'
alias ll='eza -l --icons --git'
alias la='eza -la --icons --git'
alias lt='eza --tree --level=2 --icons'

# Modern replacements are exposed under their own names.
# POSIX `grep`, `find` and `cat` are deliberately NOT shadowed: scripts and
# muscle memory depend on their real flags.
alias rgi='rg -i'
alias catp='bat --style=plain --paging=never'
alias less='bat --paging=always'

alias g='git'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gc='git commit -v'
alias gp='git push'

alias d='docker'
alias dc='docker compose'
alias lg='lazygit'
alias ld='lazydocker'

alias e='micro'
alias nano='micro'
alias v='nvim'
alias vim='nvim'

alias ..='cd ..'
alias ...='cd ../..'

alias update='gnomarchy update'
alias theme='gnomarchy theme'
alias snapshot='gnomarchy snapshot'
alias menu='gnomarchy menu'
