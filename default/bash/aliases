# Gnomarchy developer aliases
alias ls='eza --icons'
alias ll='eza -l --icons --git'
alias la='eza -la --icons --git'
alias lt='eza --tree --level=2 --icons'

alias cat='bat --paging=never'
alias grep='ripgrep'
alias find='fd'

alias g='git'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gc='git commit -v'
alias gp='git push'

alias d='docker'
alias dc='docker compose'
alias lg='lazygit'
alias ld='lazydocker'

alias e='micro'
alias nano='micro'
alias v='nvim'
alias vim='nvim'

alias ..='cd ..'
alias ...='cd ../..'

alias update='gnomarchy update'
alias theme='gnomarchy theme'
alias snapshot='gnomarchy snapshot'
