#!/bin/bash

# Compatibility shim for `gnomarchy gnome hotkeys`.
#
# This used to print a hand-written list of keybindings. It drifted from
# reality almost immediately -- it still advertised Alacritty, Super+B and six
# workspaces long after those changed -- and it could not represent the Omarchy
# layout at all. The real list is derived from dconf by gnomarchy-keybindings.

case "${1:-}" in
  reset)
    # Re-apply whichever layout profile is active rather than replaying one
    # fixed set of bindings.
    exec gnomarchy-keymap "$(cat "$HOME/.config/gnomarchy/current/keymap" 2>/dev/null || echo gnome)"
    ;;
  *)
    exec gnomarchy-keybindings "$@"
    ;;
esac
