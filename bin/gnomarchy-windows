#!/bin/bash
# Windows applications through WinBoat (https://www.winboat.app).
#
# WinBoat runs Windows in a Docker container and opens its applications as
# ordinary desktop windows over FreeRDP. It is opt-in: it is AUR-only, and the
# container needs KVM, several GB of RAM and a Windows download.
#
#   gnomarchy windows install   install WinBoat: paru winboat-bin, else the
#                               release AppImage (checksum-pinned)
#   gnomarchy windows status    what WinBoat needs, and whether this machine has it
#   gnomarchy windows           start WinBoat
set -eEo pipefail

WINBOAT_VERSION="0.9.2"
APPIMAGE_URL="https://github.com/winboat-org/winboat/releases/download/v${WINBOAT_VERSION}/winboat-${WINBOAT_VERSION}-x86_64.AppImage"
# The digest GitHub publishes for that release asset.
APPIMAGE_SHA256="6336843b911e344bf6182ebaea2d42e8960ef11820a0cc84239a848ba0a140e4"
APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/gnomarchy/winboat/WinBoat.AppImage"
DESKTOP_ENTRY="${XDG_DATA_HOME:-$HOME/.local/share}/applications/gnomarchy-winboat.desktop"
OLD_VM_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gnomarchy/vms/windows-11"

usage() {
  cat <<'EOF'
Usage: gnomarchy windows [install|status]

  install   install WinBoat (Windows apps in a container, shown as windows)
  status    check KVM, Docker and FreeRDP, and whether WinBoat is installed
  (none)    start WinBoat
EOF
}

ok() { printf '  \033[32mok\033[0m    %s\n' "$*"; }
bad() { printf '  \033[31mno\033[0m    %s\n' "$*"; }

# The command that starts WinBoat, or nothing when it is not installed.
winboat_command() {
  if command -v winboat >/dev/null 2>&1; then
    command -v winboat
  elif [[ -x "$APPIMAGE" ]]; then
    printf '%s\n' "$APPIMAGE"
  fi
}

# Each check prints one line; the status is the number of unmet requirements.
check_requirements() {
  local missing=0
  if [[ -w /dev/kvm ]]; then
    ok "KVM: /dev/kvm is usable"
  elif [[ -e /dev/kvm ]]; then
    bad "KVM: /dev/kvm exists but $USER cannot open it"
    missing=$((missing + 1))
  else
    bad "KVM: no /dev/kvm - enable virtualization (VT-x / AMD-V) in the firmware"
    missing=$((missing + 1))
  fi

  if ! command -v docker >/dev/null 2>&1; then
    bad "Docker: not installed"
    missing=$((missing + 1))
  else
    if systemctl is-active --quiet docker.service; then
      ok "Docker: the service is running"
    else
      bad "Docker: the service is not running (sudo systemctl enable --now docker)"
      missing=$((missing + 1))
    fi
    if docker compose version >/dev/null 2>&1; then
      ok "Docker: compose is available"
    else
      bad "Docker: compose is missing (sudo pacman -S docker-compose)"
      missing=$((missing + 1))
    fi
  fi

  # The docker group in /etc/group is not enough: it reaches a session only at
  # the next login.
  if id -nG | tr ' ' '\n' | grep -qx docker; then
    ok "Docker: $USER is in the docker group"
  elif getent group docker | cut -d: -f4 | tr ',' '\n' | grep -qx "$USER"; then
    bad "Docker: $USER was added to the docker group; log out and back in"
    missing=$((missing + 1))
  else
    bad "Docker: $USER is not in the docker group (sudo usermod -aG docker $USER, then log in again)"
    missing=$((missing + 1))
  fi

  if command -v xfreerdp3 >/dev/null 2>&1; then
    ok "FreeRDP: xfreerdp3 is installed"
  else
    bad "FreeRDP: not installed (sudo pacman -S freerdp)"
    missing=$((missing + 1))
  fi
  return "$missing"
}

install_appimage() {
  local tmp
  echo "==> Installing the WinBoat $WINBOAT_VERSION AppImage"
  # AppImages mount themselves with FUSE 2; freerdp is what WinBoat drives.
  sudo pacman -S --needed --noconfirm fuse2 freerdp
  mkdir -p "${APPIMAGE%/*}"
  tmp="$APPIMAGE.download"
  curl -fL --retry 3 -o "$tmp" "$APPIMAGE_URL"
  if [[ "$(sha256sum "$tmp" | cut -d' ' -f1)" != "$APPIMAGE_SHA256" ]]; then
    rm -f "$tmp"
    echo "The downloaded AppImage does not match its published checksum; not installing it." >&2
    return 1
  fi
  chmod +x "$tmp"
  mv -f "$tmp" "$APPIMAGE"

  mkdir -p "${DESKTOP_ENTRY%/*}"
  cat >"$DESKTOP_ENTRY" <<EOF
[Desktop Entry]
Type=Application
Name=WinBoat
Comment=Windows applications in a container
Exec=$APPIMAGE
Icon=computer
Categories=System;Emulator;
Terminal=false
EOF
  echo "Installed $APPIMAGE"
}

cmd_install() {
  if [[ -n "$(winboat_command)" ]]; then
    echo "WinBoat is already installed: $(winboat_command)"
    return 0
  fi

  if [[ ! -e /dev/kvm ]]; then
    echo "No /dev/kvm: WinBoat runs Windows under KVM. Enable virtualization (VT-x / AMD-V) in the firmware first." >&2
    exit 1
  fi

  # Docker is in the base install; make sure it is actually running.
  if ! systemctl is-active --quiet docker.service; then
    sudo systemctl enable --now docker.service
  fi

  if command -v paru >/dev/null 2>&1 && paru -S --needed --noconfirm winboat-bin; then
    echo "Installed winboat-bin from the AUR."
  else
    echo "paru could not install winboat-bin; using the release AppImage instead."
    install_appimage
  fi

  echo
  echo "==> Requirements"
  if check_requirements; then
    echo
    echo "Start it with: gnomarchy windows"
    echo "The first start downloads Windows and creates the container; that takes a while."
  else
    echo
    echo "Fix the lines marked 'no' above, then start it with: gnomarchy windows"
  fi
}

cmd_status() {
  echo "WinBoat:"
  if [[ -n "$(winboat_command)" ]]; then
    ok "installed: $(winboat_command)"
  else
    bad "not installed (gnomarchy windows install)"
  fi
  # The QEMU VM this command used to create is not touched: it may hold data.
  if [[ -d "$OLD_VM_DIR" ]]; then
    echo "  note  the old QEMU VM is still in $OLD_VM_DIR; Gnomarchy no longer runs it"
  fi
  echo "Requirements:"
  # Reported, never fatal: status describes the machine.
  check_requirements || true
}

case "${1:-}" in
  install) cmd_install ;;
  status) cmd_status ;;
  -h | --help | help) usage ;;
  "")
    winboat="$(winboat_command)"
    if [[ -z "$winboat" ]]; then
      echo "WinBoat is not installed. Install it with: gnomarchy windows install" >&2
      exit 1
    fi
    exec "$winboat"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
