#!/bin/bash

# List all available Gnomarchy themes
GNOMARCHY_PATH="${GNOMARCHY_PATH:-$HOME/.local/share/gnomarchy}"
SYSTEM_THEMES_DIR="$GNOMARCHY_PATH/themes"
USER_THEMES_DIR="$HOME/.config/gnomarchy/themes"

CURRENT_THEME=""
if [[ -f "$HOME/.config/gnomarchy/current/theme.name" ]]; then
  CURRENT_THEME="$(<"$HOME/.config/gnomarchy/current/theme.name")"
fi

echo -e "\033[1;36mGnomarchy Curated Themes (22 Built-in)\033[0m"
echo "========================================"

format_theme_item() {
  local theme_path="$1"
  local name="$(basename "$theme_path")"
  local mode="dark"
  local accent=""
  
  if [[ -f "$theme_path/light.mode" ]]; then
    mode="light"
  fi
  if [[ -f "$theme_path/accent.txt" ]]; then
    accent="$(<"$theme_path/accent.txt")"
  fi

  local info="[${mode}${accent:+, accent: $accent}]"
  if [[ "$name" == "$CURRENT_THEME" ]]; then
    printf "  * \033[1;32m%-18s\033[0m \033[0;33m%-24s\033[0m \033[1;32m(active)\033[0m\n" "$name" "$info"
  else
    printf "    %-18s \033[0;90m%-24s\033[0m\n" "$name" "$info"
  fi
}

list_dir_themes() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    for theme in "$dir"/*; do
      if [[ -d "$theme" ]]; then
        format_theme_item "$theme"
      fi
    done
  fi
}

list_dir_themes "$SYSTEM_THEMES_DIR"
if [[ -d "$USER_THEMES_DIR" ]]; then
  echo -e "\n\033[1;36mUser Custom Themes:\033[0m"
  list_dir_themes "$USER_THEMES_DIR"
fi
