#!/bin/bash

# Gnomarchy keyboard layout profiles
#
#   omarchy  Mirrors Omarchy's Hyprland bindings as closely as GNOME allows:
#            Super+arrows to focus, Super+Shift+arrows to move, ten workspaces
#            on Super+1..0, Super+Q/W to close.
#
#            One deliberate departure: Omarchy puts its menu on Super+Space,
#            which in GNOME switches the keyboard layout. Layout switching is
#            used far more often than a launcher, so it keeps Super+Space and
#            the menu stays on Super+Alt+Space.
#
#   gnome    Gnomarchy's own defaults: six workspaces, Super+B/E for browser
#            and files, Super+Alt+Space for the menu.
#
# Bindings were transcribed from Omarchy's default/hypr/bindings/*.lua rather
# than from memory. What Hyprland does and GNOME does not - window groups, the
# scratchpad, pseudo-tiling, pixel-exact resize steps - is listed by
# `gnomarchy keymap status` instead of being silently dropped.
set -eEo pipefail

FORGE_KEYS="org.gnome.shell.extensions.forge.keybindings"
WM="org.gnome.desktop.wm.keybindings"
SHELL_KEYS="org.gnome.shell.keybindings"
MK="org.gnome.settings-daemon.plugins.media-keys"
BINDINGS="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"

info() { echo -e "\033[1;36m$1\033[0m"; }
good() { echo -e "\033[1;32m  $1\033[0m"; }
warn() { echo -e "\033[1;33m  $1\033[0m"; }

require_session() {
  if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && ! -S "/run/user/$(id -u)/bus" ]]; then
    echo "No D-Bus session bus; run this from inside your desktop session." >&2
    exit 1
  fi
}

set_custom() {
  # $1 slot, $2 name, $3 command, $4 binding
  local p="$MK.custom-keybinding:$BINDINGS/$1/"
  gsettings set "$p" name "$2"
  gsettings set "$p" command "$3"
  gsettings set "$p" binding "$4"
}

register_slots() {
  local slots=() i
  for i in "$@"; do slots+=("'$BINDINGS/$i/'"); done
  local list
  list="$(IFS=,; echo "${slots[*]}")"
  gsettings set "$MK" custom-keybindings "[$list]"
}

BROWSER_CMD='sh -c "command -v brave-origin >/dev/null && exec brave-origin || command -v brave >/dev/null && exec brave || exec xdg-open https://"'

# Dynamic tiling needs K and Shift+K for hjkl navigation, so `gnomarchy tiling
# enable` moves the keybindings browser and the manual onto Super+/ and
# Super+Shift+/. Switching keymap profile must not quietly put them back on top
# of Forge -- that is how two handlers end up on one accelerator.
dynamic_tiling_active() {
  local enabled
  enabled="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo '')"
  [[ "$enabled" == *"forge@jmmaranan.com"* ]]
}

KEYS_BINDING='<Super>k'
MANUAL_BINDING='<Super><Shift>k'
KEYS_LABEL='Super + K'
MANUAL_LABEL='Super + Shift + K'
if dynamic_tiling_active; then
  KEYS_BINDING='<Super>slash'
  MANUAL_BINDING='<Super><Shift>slash'
  KEYS_LABEL='Super + /'
  MANUAL_LABEL='Super + Shift + /'
fi

apply_omarchy() {
  info "Applying the Omarchy keyboard layout"

  # --- Workspaces: Omarchy runs ten, Gnomarchy shipped six ------------------
  gsettings set org.gnome.mutter dynamic-workspaces false
  gsettings set org.gnome.desktop.wm.preferences num-workspaces 10

  local i key
  for i in $(seq 1 10); do
    # Workspace 10 sits on the 0 key, as in Omarchy.
    key=$((i % 10))
    gsettings set "$WM" "switch-to-workspace-$i" "['<Super>$key']"
    gsettings set "$WM" "move-to-workspace-$i" "['<Super><Shift>$key']"

    # GNOME Shell's switch-to-application-N sits on the same Super+N. This
    # profile takes all ten digits, so all nine app keys go. There is no
    # switch-to-application-10, so the 0 key needs nothing -- and this has to
    # be an if, not `(( )) &&`: a false (( )) returns 1, which under set -e
    # would end the script on the tenth pass.
    if ((key != 0)); then
      gsettings set "$SHELL_KEYS" "switch-to-application-$key" "@as []"
    fi
  done

  # Super+Tab cycles workspaces in Omarchy. GNOME binds it to the application
  # switcher by default, so that has to move out of the way first.
  gsettings set "$WM" switch-applications "['<Alt>Tab']"
  gsettings set "$WM" switch-applications-backward "['<Alt><Shift>Tab']"
  gsettings set "$WM" switch-windows "['<Alt>grave']"
  gsettings set "$WM" switch-windows-backward "['<Alt><Shift>grave']"

  gsettings set "$WM" switch-to-workspace-right "['<Super>Tab']"
  gsettings set "$WM" switch-to-workspace-left "['<Super><Shift>Tab']"
  gsettings set "$WM" switch-to-workspace-last "['<Super><Control>Tab']"

  # --- Windows --------------------------------------------------------------
  gsettings set "$WM" close "['<Super>w', '<Super>q']"
  gsettings set "$WM" toggle-fullscreen "['<Super>f']"
  gsettings set "$WM" toggle-maximized "['<Super><Alt>f']"
  gsettings set "$WM" begin-resize "['<Super>BackSpace']"
  gsettings set "$WM" maximize "@as []"
  # Super+Up and Super+Down go to directional focus on this profile, so the
  # maximize pair gives them up. Alt+F5 still unmaximizes.
  gsettings set "$WM" unmaximize "['<Alt>F5']"

  # Super+Space stays with GNOME's input-source switching. Omarchy puts its
  # menu there, but a keyboard layout toggle is used far more often than a
  # launcher, so the menu keeps Gnomarchy's Super+Alt+Space instead.

  # Super+drag to move, Super+right-drag to resize, as in Hyprland.
  gsettings set org.gnome.desktop.wm.preferences mouse-button-modifier "'<Super>'"

  # --- Directional focus and movement --------------------------------------
  # These live in Forge, so they only do anything in dynamic mode. Omarchy
  # navigates with the arrows; hjkl is kept as an alternate because this
  # profile leaves `maximize` unbound, so Super+Up is free and both can coexist.
  if gsettings list-schemas 2>/dev/null | grep -q "^$FORGE_KEYS$"; then
    gsettings set "$FORGE_KEYS" window-focus-left "['<Super>Left', '<Super>h']"
    gsettings set "$FORGE_KEYS" window-focus-right "['<Super>Right', '<Super>l']"
    gsettings set "$FORGE_KEYS" window-focus-up "['<Super>Up', '<Super>k']"
    gsettings set "$FORGE_KEYS" window-focus-down "['<Super>Down', '<Super>j']"

    gsettings set "$FORGE_KEYS" window-move-left "['<Super><Shift>Left', '<Super><Shift>h']"
    gsettings set "$FORGE_KEYS" window-move-right "['<Super><Shift>Right', '<Super><Shift>l']"
    gsettings set "$FORGE_KEYS" window-move-up "['<Super><Shift>Up', '<Super><Shift>k']"
    gsettings set "$FORGE_KEYS" window-move-down "['<Super><Shift>Down', '<Super><Shift>j']"
  else
    warn "Forge is not installed; directional focus needs 'gnomarchy tiling enable'."
  fi

  # --- Applications and menus ----------------------------------------------
  register_slots custom0 custom1 custom2 custom3 custom4 custom5 custom6 custom7 custom8 custom9
  set_custom custom0 'Terminal' 'gnome-terminal' '<Super>Return'
  set_custom custom1 'Browser' "$BROWSER_CMD" '<Super><Shift>b'
  set_custom custom2 'Files' 'nautilus' '<Super><Shift>f'
  set_custom custom3 'Annotate Screenshot' 'gnomarchy-capture annotate' '<Control>Print'
  set_custom custom4 'Voxtype AI Dictation' 'gnomarchy voxtype toggle' '<Super>d'
  set_custom custom5 'System Menu' 'gnomarchy-menu' '<Super>Escape'
  set_custom custom6 'Gnomarchy Menu' 'gnomarchy-menu' '<Super><Alt>space'
  set_custom custom7 'Keybindings' 'gnomarchy-keybindings' "$KEYS_BINDING"
  set_custom custom8 'Editor' 'code' '<Super><Shift>n'
  set_custom custom9 'Manual' 'gnomarchy-manual' "$MANUAL_BINDING"

  # Omarchy puts its apps menu on Super+Alt+Space, but that is the Gnomarchy
  # menu here, so the app grid keeps GNOME's own Super+A.
  gsettings reset org.gnome.shell.keybindings toggle-application-view 2>/dev/null || true

  echo omarchy > "$HOME/.config/gnomarchy/current/keymap" 2>/dev/null || true

  good "Omarchy layout applied"
}

apply_gnome() {
  info "Restoring the Gnomarchy default layout"

  gsettings set org.gnome.desktop.wm.preferences num-workspaces 6
  local i
  for i in $(seq 1 10); do
    if ((i <= 6)); then
      gsettings set "$WM" "switch-to-workspace-$i" "['<Super>$i']"
      gsettings set "$WM" "move-to-workspace-$i" "['<Super><Shift>$i']"
    else
      gsettings set "$WM" "switch-to-workspace-$i" "@as []"
      gsettings set "$WM" "move-to-workspace-$i" "@as []"
    fi

    # Six workspaces here, so Super+7..9 go back to GNOME Shell's
    # switch-to-application -- the Omarchy profile takes all nine and this is
    # the branch that has to hand them back.
    if ((i <= 6)); then
      gsettings set "$SHELL_KEYS" "switch-to-application-$i" "@as []"
    elif ((i <= 9)); then
      gsettings reset "$SHELL_KEYS" "switch-to-application-$i"
    fi
  done

  gsettings set "$WM" close "['<Super>w']"
  gsettings set "$WM" maximize "['<Super>Up']"
  gsettings set "$WM" toggle-fullscreen "['<Shift>F11']"
  gsettings set "$WM" toggle-maximized "@as []"
  gsettings set "$WM" switch-to-workspace-right "@as []"
  gsettings set "$WM" switch-to-workspace-left "@as []"
  gsettings set "$WM" switch-to-workspace-last "@as []"
  gsettings set "$WM" switch-applications "['<Super>Tab', '<Alt>Tab']"
  gsettings reset "$WM" switch-input-source 2>/dev/null || true

  register_slots custom0 custom1 custom2 custom3 custom4 custom5 custom6 custom7 custom8
  set_custom custom0 'Terminal' 'gnome-terminal' '<Super>Return'
  set_custom custom1 'Browser' "$BROWSER_CMD" '<Super>b'
  set_custom custom2 'Files' 'nautilus' '<Super>e'
  set_custom custom3 'Annotate Screenshot' 'gnomarchy-capture annotate' '<Control>Print'
  set_custom custom4 'Voxtype AI Dictation' 'gnomarchy voxtype toggle' '<Super>d'
  set_custom custom5 'Retro Screensaver' 'gnomarchy screensaver' '<Super>Escape'
  set_custom custom6 'Gnomarchy Menu' 'gnomarchy-menu' '<Super><Alt>space'
  set_custom custom7 'Keybindings' 'gnomarchy-keybindings' "$KEYS_BINDING"
  set_custom custom8 'Manual' 'gnomarchy-manual' "$MANUAL_BINDING"

  # hjkl only on this profile: Super+Up is `maximize` here, so the arrow
  # alternates Forge ships by default would be a second handler on that key.
  if gsettings list-schemas 2>/dev/null | grep -q "^$FORGE_KEYS$"; then
    gsettings set "$FORGE_KEYS" window-focus-left "['<Super>h']"
    gsettings set "$FORGE_KEYS" window-focus-down "['<Super>j']"
    gsettings set "$FORGE_KEYS" window-focus-up "['<Super>k']"
    gsettings set "$FORGE_KEYS" window-focus-right "['<Super>l']"
    gsettings set "$FORGE_KEYS" window-move-left "['<Super><Shift>h']"
    gsettings set "$FORGE_KEYS" window-move-down "['<Super><Shift>j']"
    gsettings set "$FORGE_KEYS" window-move-up "['<Super><Shift>k']"
    gsettings set "$FORGE_KEYS" window-move-right "['<Super><Shift>l']"
    gsettings set "$FORGE_KEYS" window-toggle-float "['<Super>c']"
  fi

  echo gnome > "$HOME/.config/gnomarchy/current/keymap" 2>/dev/null || true

  good "Gnomarchy default layout restored"
}

show_status() {
  local current="gnome"
  [[ -f "$HOME/.config/gnomarchy/current/keymap" ]] &&
    current="$(<"$HOME/.config/gnomarchy/current/keymap")"

  echo "Keyboard layout: $current"
  echo

  if [[ "$current" == "omarchy" ]]; then
    cat <<EOF
  Super + Return            terminal
  Super + Shift + B         browser
  Super + Shift + F         file manager
  Super + Shift + N         editor
  Super + Alt + Space       Gnomarchy menu
  Super + Space             switch keyboard layout (GNOME default)
  Super + A                 app grid
  Super + Escape            system menu
  $(printf '%-24s' "$KEYS_LABEL")this list
  $(printf '%-24s' "$MANUAL_LABEL")the manual

  Super + W / Super + Q     close window
  Super + F                 fullscreen
  Super + Alt + F           maximize
  Super + arrows            focus window (dynamic tiling only)
  Super + Shift + arrows    move window (dynamic tiling only)
  Super + drag              move window
  Super + right-drag        resize window

  Super + 1..0              switch to workspace 1..10
  Super + Shift + 1..0      move window to workspace
  Super + Tab               next workspace
  Super + Shift + Tab       previous workspace
  Super + Ctrl + Tab        last workspace
  Alt + Tab                 switch application

Not translatable to GNOME, so deliberately unbound:
  window groups (Super+G), the scratchpad (Super+S),
  pseudo-tiling (Super+P), pixel-step window resize,
  per-monitor workspace moves.
EOF
  else
    cat <<EOF
  Super + Return            terminal
  Super + B                 browser
  Super + E                 file manager
  Super + Alt + Space       Gnomarchy menu
  Super + Escape            screensaver
  $(printf '%-24s' "$KEYS_LABEL")searchable keybindings
  $(printf '%-24s' "$MANUAL_LABEL")the manual
  Super + T                 cycle the zone layout (manual tiling)

  Super + W                 close window
  Super + Up                maximize
  Super + 1..6              switch to workspace 1..6
  Super + Shift + 1..6      move window to workspace
EOF
  fi

  echo
  echo "Switch with: gnomarchy keymap <omarchy|gnome>"
}

case "${1:-status}" in
  omarchy)
    require_session
    mkdir -p "$HOME/.config/gnomarchy/current"
    apply_omarchy
    echo
    warn "Directional focus needs dynamic tiling: gnomarchy tiling enable"
    echo
    show_status
    ;;
  gnome | default | reset)
    require_session
    mkdir -p "$HOME/.config/gnomarchy/current"
    apply_gnome
    echo
    show_status
    ;;
  status) show_status ;;
  *)
    echo "Usage: gnomarchy keymap <omarchy|gnome|status>"
    echo
    echo "  omarchy   mirror Omarchy's Hyprland bindings"
    echo "  gnome     Gnomarchy defaults"
    echo "  status    show the active layout"
    exit 1
    ;;
esac
