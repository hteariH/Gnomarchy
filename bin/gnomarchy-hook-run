#!/bin/bash

# Gnomarchy Event Hook Runner
# Usage: gnomarchy-hook-run <hook-name> [args...]

set -e

hook_name="$1"
shift || true

if [[ -z "$hook_name" ]]; then
  echo "Usage: gnomarchy-hook-run <hook-name> [args...]" >&2
  exit 1
fi

HOOK_USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gnomarchy/hooks"
HOOK_SYSTEM_DIR="/etc/gnomarchy/hooks"

# 1. Check user-level hook
if [[ -f "$HOOK_USER_DIR/$hook_name" ]]; then
  if [[ -x "$HOOK_USER_DIR/$hook_name" ]]; then
    "$HOOK_USER_DIR/$hook_name" "$@" || {
      echo "[hook] Warning: Hook '$hook_name' exited with non-zero status ($?)" >&2
    }
  else
    bash "$HOOK_USER_DIR/$hook_name" "$@" || {
      echo "[hook] Warning: Hook '$hook_name' exited with non-zero status ($?)" >&2
    }
  fi
# 2. Check system-level hook
elif [[ -f "$HOOK_SYSTEM_DIR/$hook_name" ]]; then
  if [[ -x "$HOOK_SYSTEM_DIR/$hook_name" ]]; then
    "$HOOK_SYSTEM_DIR/$hook_name" "$@" || {
      echo "[hook] Warning: System hook '$hook_name' exited with non-zero status ($?)" >&2
    }
  else
    bash "$HOOK_SYSTEM_DIR/$hook_name" "$@" || {
      echo "[hook] Warning: System hook '$hook_name' exited with non-zero status ($?)" >&2
    }
  fi
fi

exit 0
