#!/bin/bash

# Gnomarchy gaming stack
#
# One command for what a gaming setup on Arch actually needs: Steam and the
# 32-bit libraries it depends on, Proton-GE with a manager to keep it current,
# Wine, a launcher for non-Steam games, and the overlay and scheduling tools.
#
#   gnomarchy gaming install   install the stack
#   gnomarchy gaming status    what is present
#   gnomarchy gaming proton    manage Proton versions
#
# Package names were checked against the current core, extra and multilib
# databases rather than assumed.
set -eEo pipefail

info() { echo -e "\n\033[1;36m==> $1\033[0m"; }
good() { echo -e "\033[1;32m  $1\033[0m"; }
warn() { echo -e "\033[1;33m  $1\033[0m"; }
step() { echo -e "\033[0;36m  - $1\033[0m"; }

# Steam and every 32-bit library are in multilib; without it none of this
# resolves.
ensure_multilib() {
  if grep -q "^\[multilib\]" /etc/pacman.conf 2>/dev/null; then
    return 0
  fi
  info "Enabling the multilib repository"
  if grep -q "^#\[multilib\]" /etc/pacman.conf; then
    sudo sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf
  else
    printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' | sudo tee -a /etc/pacman.conf >/dev/null
  fi
  sudo pacman -Sy --noconfirm
  good "multilib enabled"
}

# The 32-bit Vulkan driver has to match the GPU; installing all of them pulls
# in conflicting stacks.
detect_gpu_packages() {
  local gpu packages=()
  gpu="$(lspci 2>/dev/null | grep -iE 'vga|3d|display' || true)"

  if grep -qi 'nvidia' <<<"$gpu"; then
    packages+=(lib32-nvidia-utils)
  fi
  # Match the vendor strings lspci actually prints. A bare "ati" would match
  # the "ati" inside "Corporation" and "compatible" and tag every GPU as AMD.
  if grep -qiE 'advanced micro devices|\[amd/ati\]|radeon' <<<"$gpu"; then
    packages+=(lib32-vulkan-radeon)
  fi
  if grep -qi 'intel' <<<"$gpu"; then
    packages+=(lib32-vulkan-intel)
  fi

  # A VM or an unrecognised card still needs something to render through.
  ((${#packages[@]} == 0)) && packages+=(lib32-mesa)

  printf '%s\n' "${packages[@]}"
}

REPO_PACKAGES=(
  steam                    # multilib
  lutris                   # non-Steam games
  gamescope                # micro-compositor for scaling and framerate control
  gamemode lib32-gamemode  # CPU governor and scheduling while a game runs
  mangohud lib32-mangohud  # performance overlay
  goverlay                 # configures MangoHud without editing files
  wine winetricks          # Windows programs outside Proton
  vkd3d lib32-vkd3d        # Direct3D 12
  umu-launcher             # runs Proton outside Steam, what Lutris and Faugus use
  lib32-mesa
  vulkan-icd-loader lib32-vulkan-icd-loader
  lib32-alsa-plugins lib32-libpulse
  ttf-liberation           # fonts many Windows games expect
)

# Not in the official repositories; installed through an AUR helper, with a
# Flatpak fallback so the stack still works without one.
AUR_PACKAGES=(
  proton-ge-custom-bin     # Proton-GE, the community build most games want
  protonup-qt              # manages Proton-GE and Wine-GE versions
  faugus-launcher          # simple launcher for Windows games
)

FLATPAK_FALLBACK=(
  "net.davidotek.pupgui2"            # ProtonUp-Qt
  "io.github.Faugus.faugus-launcher" # Faugus Launcher
)

aur_helper() {
  for helper in paru yay; do
    command -v "$helper" >/dev/null 2>&1 && {
      printf '%s' "$helper"
      return 0
    }
  done
  return 1
}

do_install() {
  ensure_multilib

  info "Installing the gaming stack from the official repositories"
  mapfile -t gpu_packages < <(detect_gpu_packages)
  step "GPU packages: ${gpu_packages[*]}"

  local all=("${REPO_PACKAGES[@]}" "${gpu_packages[@]}")

  # Skip anything the repositories do not have rather than letting one bad
  # name abort the whole transaction.
  local resolved=() missing=()
  for pkg in "${all[@]}"; do
    if pacman -Si "$pkg" >/dev/null 2>&1; then
      resolved+=("$pkg")
    else
      missing+=("$pkg")
    fi
  done

  ((${#missing[@]})) && warn "Not available, skipping: ${missing[*]}"

  sudo pacman -S --noconfirm --needed "${resolved[@]}"
  good "Installed ${#resolved[@]} packages"

  # Proton-GE and the launchers.
  if helper="$(aur_helper)"; then
    info "Installing Proton-GE and launchers from the AUR ($helper)"
    for pkg in "${AUR_PACKAGES[@]}"; do
      step "$pkg"
      "$helper" -S --needed --noconfirm "$pkg" ||
        warn "$pkg failed; continuing"
    done
  else
    warn "No AUR helper found; falling back to Flatpak for the launchers."
    if command -v flatpak >/dev/null 2>&1; then
      for app in "${FLATPAK_FALLBACK[@]}"; do
        step "$app"
        flatpak install -y --noninteractive flathub "$app" ||
          warn "$app failed; continuing"
      done
    else
      warn "Neither an AUR helper nor Flatpak is available."
      warn "Proton-GE was not installed; see 'gnomarchy manual gaming'."
    fi
  fi

  # gamemode only takes effect for users in its group.
  if getent group gamemode >/dev/null 2>&1; then
    sudo usermod -aG gamemode "$USER" 2>/dev/null || true
    step "Added $USER to the gamemode group (takes effect at next login)"
  fi

  info "Done"
  echo
  echo "  Steam            launch and sign in; enable Proton under"
  echo "                   Settings > Compatibility for non-native titles"
  echo "  ProtonUp-Qt      install and update Proton-GE builds"
  echo "  Faugus Launcher  run Windows games outside Steam"
  echo "  MangoHud         overlay: MANGOHUD=1 %command% in Steam launch options"
  echo "  gamescope        e.g. gamescope -W 2560 -H 1440 -f -- %command%"
  echo
  warn "Log out and back in for the gamemode group to apply."
}

show_status() {
  echo "Gaming stack:"
  echo

  local any=0
  check() {
    local cmd="$1" label="$2"
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '  \033[0;32m*\033[0m %s\n' "$label"
      any=1
    else
      printf '  \033[0;90m-\033[0m %s\n' "$label"
    fi
  }

  check steam "Steam"
  check lutris "Lutris"
  check gamescope "gamescope"
  check gamemoderun "GameMode"
  check mangohud "MangoHud"
  check wine "Wine"
  check umu-run "umu-launcher"
  check protonup-qt "ProtonUp-Qt"
  check faugus-launcher "Faugus Launcher"

  echo
  if grep -q "^\[multilib\]" /etc/pacman.conf 2>/dev/null; then
    echo "  multilib: enabled"
  else
    echo "  multilib: DISABLED - Steam cannot be installed without it"
  fi

  local ge_dir="$HOME/.steam/root/compatibilitytools.d"
  if [[ -d "$ge_dir" ]]; then
    local count
    count="$(find "$ge_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)"
    echo "  Proton-GE builds installed: $count"
  fi

  ((any)) || echo -e "\n  Install it with: gnomarchy gaming install"
}

case "${1:-status}" in
  install | setup)
    do_install
    ;;
  status)
    show_status
    ;;
  proton)
    if command -v protonup-qt >/dev/null 2>&1; then
      exec protonup-qt
    elif flatpak info net.davidotek.pupgui2 >/dev/null 2>&1; then
      exec flatpak run net.davidotek.pupgui2
    else
      echo "ProtonUp-Qt is not installed. Run: gnomarchy gaming install" >&2
      exit 1
    fi
    ;;
  *)
    echo "Usage: gnomarchy gaming <install|status|proton>"
    echo
    echo "  install   Steam, Proton-GE, Wine, Lutris, launchers and overlays"
    echo "  status    what is present"
    echo "  proton    manage Proton versions (ProtonUp-Qt)"
    exit 1
    ;;
esac
