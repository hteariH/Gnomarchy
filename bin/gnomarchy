#!/bin/bash

# Gnomarchy Master CLI Dispatcher
set -e

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
GNOMARCHY_BIN_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
export GNOMARCHY_PATH="${GNOMARCHY_PATH:-$(cd -- "$GNOMARCHY_BIN_DIR/.." && pwd)}"
export PATH="$GNOMARCHY_BIN_DIR:$PATH"

command_group="$1"
subcommand="$2"

usage() {
  cat <<'EOF'
Usage: gnomarchy <command> [subcommand] [arguments...]

Commands:
  menu                         Open the Gnomarchy command center (Super+Alt+Space)
  first-run                    Re-apply desktop settings, shortcuts and favorites
  theme <set|list|current>     Manage system and desktop color themes
  tiling <enable|disable|status>
                               Dynamic auto-tiling (Hyprland-style) or manual grid
  keymap <omarchy|gnome|status>
                               Switch between Omarchy and Gnomarchy key layouts
  keybindings [--list]         Search the keybindings that are actually active
  manual [page|--grep <text>]  Read the Gnomarchy manual
  gaming <install|status|proton>
                               Steam, Proton-GE, Wine and launchers in one go
  asus <status|charge|profile|keyboard|graphics>
                               Asus ROG/TUF laptop controls
  backgrounds [--list|--verify]
                               Fetch/verify theme wallpapers for this machine
  gnome <extensions|hotkeys|scaling|restart>
                               Manage GNOME desktop settings & workflow
  snapshot <create|list>       Manage Btrfs Snapper rollback snapshots
  agent <list|claude|opencode|pi|aider>
                               Launch or inspect AI coding agents & skills
  webapp <add|list|remove>     Turn websites into isolated desktop applications
  voxtype [toggle|start|stop]  Speech-to-text AI dictation (Super+D)
  windows <setup|start|stop>   Manage accelerated Windows 11 KVM VM
  reminder <time|dur> <msg>    Schedule desktop notification reminders
  capture <annotate|region|screen>
                               Screenshot, optionally into the Satty annotator
  screensaver                  Launch retro fullscreen Matrix terminal screensaver
  hook <run|list>              Trigger or inspect Gnomarchy lifecycle hooks
  update                       Perform system & Gnomarchy configuration updates
  migrate [--list]             Apply pending Gnomarchy migrations
  version                      Display Gnomarchy version
  help                         Show this help message
EOF
}

if [[ -z "$command_group" || "$command_group" == "help" || "$command_group" == "--help" || "$command_group" == "-h" ]]; then
  usage
  exit 0
fi

case "$command_group" in
  menu)
    exec gnomarchy-menu
    ;;
  first-run)
    exec gnomarchy-first-run
    ;;
  backgrounds)
    shift
    exec gnomarchy-backgrounds "$@"
    ;;
  tiling)
    shift
    exec gnomarchy-tiling "$@"
    ;;
  keymap)
    shift
    exec gnomarchy-keymap "$@"
    ;;
  keybindings | keys)
    shift
    exec gnomarchy-keybindings "$@"
    ;;
  manual | docs)
    shift
    exec gnomarchy-manual "$@"
    ;;
  gaming | games)
    shift
    exec gnomarchy-gaming "$@"
    ;;
  asus | rog)
    shift
    exec gnomarchy-asus "$@"
    ;;
  theme)
    case "$subcommand" in
      set)
        shift 2
        exec gnomarchy-theme-set "$@"
        ;;
      list)
        exec gnomarchy-theme-list
        ;;
      current)
        exec gnomarchy-theme-current
        ;;
      *)
        echo "Usage: gnomarchy theme <set|list|current>"
        exit 1
        ;;
    esac
    ;;
  gnome)
    case "$subcommand" in
      extensions)
        shift 2
        exec gnomarchy-gnome-extensions "$@"
        ;;
      hotkeys)
        exec gnomarchy-gnome-hotkeys
        ;;
      scaling)
        shift 2
        exec gnomarchy-gnome-scaling "$@"
        ;;
      restart)
        exec gnomarchy-gnome-restart
        ;;
      *)
        echo "Usage: gnomarchy gnome <extensions|hotkeys|scaling|restart>"
        exit 1
        ;;
    esac
    ;;
  snapshot)
    case "$subcommand" in
      create)
        shift 2
        exec gnomarchy-snapshot-create "$@"
        ;;
      list)
        exec gnomarchy-snapshot-list
        ;;
      *)
        echo "Usage: gnomarchy snapshot <create|list>"
        exit 1
        ;;
    esac
    ;;
  agent)
    shift
    exec gnomarchy-agent "$@"
    ;;
  webapp)
    shift
    exec gnomarchy-webapp "$@"
    ;;
  voxtype)
    shift
    exec gnomarchy-voxtype "$@"
    ;;
  windows)
    shift
    exec gnomarchy-windows "$@"
    ;;
  reminder)
    shift
    exec gnomarchy-reminder "$@"
    ;;
  capture)
    shift
    exec gnomarchy-capture "$@"
    ;;
  screensaver)
    exec gnomarchy-screensaver
    ;;
  hook)
    shift
    exec gnomarchy-hook-run "$@"
    ;;
  update)
    exec gnomarchy-update
    ;;
  migrate)
    shift
    exec gnomarchy-migrate "$@"
    ;;
  version)
    exec gnomarchy-version
    ;;
  *)
    # Check if direct binary exists (e.g. gnomarchy-theme-set)
    if command -v "gnomarchy-$command_group" >/dev/null 2>&1; then
      shift
      exec "gnomarchy-$command_group" "$@"
    else
      echo "Unknown command: $command_group"
      usage
      exit 1
    fi
    ;;
esac
